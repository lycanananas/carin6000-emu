# Machine state (NV + flash) and MAME settings, see tools/carin.py
/state/
# Per-run logs and the build log
/logs/
# Scratch: extracted files, Ghidra projects, old notes
/temp/
# CD image data
/cd/

__pycache__/
# Custom firmware builds: binaries stay out of git (modules, ELF, disc images, WADs, downloads)
/cfw/*/build/
/cfw/**/*.o
/cfw/**/*.elf
/cfw/**/*.bin
/cfw/**/*.mod
/cfw/**/*.img
/cfw/**/*.chd
/cfw/**/*.wad
/cfw/**/*.zip
